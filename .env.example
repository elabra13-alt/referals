# =============================================================================
# Referals — environment configuration
# =============================================================================
# Setup:
#   1. cp .env.example .env
#   2. Generate the secrets below (never commit .env):
#        openssl rand -hex 32     # -> WEBHOOK_ENCRYPTION_KEY
#        openssl rand -hex 32     # -> ADMIN_API_TOKEN
#   3. Docker:  docker compose up -d --build
#      Local:   docker compose up -d postgres redis && npm run db:migrate && npm run dev
#
# Under docker compose, DATABASE_URL and REDIS_URL are overridden with in-network
# addresses (postgres:5432 / redis:6379); the localhost values below are for
# running the app directly on your machine.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# development | test | production (docker compose forces production).
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- PostgreSQL 16 -------------------------------------------------------------
# Used by docker compose to initialise the database container. Use a strong
# password in production; it must be URL-safe (letters, digits, - _ .) because it
# is embedded in DATABASE_URL.
POSTGRES_USER=referals
POSTGRES_PASSWORD=referals_secret_pass
POSTGRES_DB=referals_db
DATABASE_URL=postgres://referals:referals_secret_pass@localhost:5432/referals_db

# --- Redis 7 (rate limiting, locks) --------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Security --------------------------------------------------------------------
# REQUIRED in production. AES-256-GCM key that encrypts seller webhook secrets at
# rest. 64 hex chars (32 bytes) from `openssl rand -hex 32`; a 32+ char passphrase
# is also accepted. Outside production a public dev-only key is used when empty.
# Changing it makes existing encrypted secrets unreadable — rotate deliberately.
WEBHOOK_ENCRYPTION_KEY=

# Platform-operator token (32+ chars) for POST /v1/sellers and the /v1/creators
# admin endpoints, sent as X-Referals-Admin-Token. Leave empty to disable them.
ADMIN_API_TOKEN=

# "true", "false", or comma-separated trusted proxy IPs/CIDRs (e.g. 10.0.0.0/8).
# Set this behind a load balancer / CDN so request.ip is the real buyer IP that
# the coupon rate limiter keys on. Never "true" when directly exposed.
TRUST_PROXY=false

# --- Buyer links -------------------------------------------------------------------
# Public base URL creator links are shared under: <base>/<link_slug>.
# This host must route /r/* to the API (the landing page is served there).
PUBLIC_LINK_BASE_URL=https://referals.mx/r

# --- Escrow worker -------------------------------------------------------------------
# How often matured escrow payouts are released, and how many per DB transaction.
ESCROW_WORKER_INTERVAL_MS=60000
ESCROW_WORKER_BATCH_SIZE=500

# --- AI scripts (Google Gemini) -------------------------------------------------------
# Optional. With a key, creator video scripts are written live by Gemini (JSON mode);
# without one — or whenever Gemini fails, times out or answers badly — the built-in
# Spanish (MX) template is used, so link issuance never breaks. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Must be a currently served model (gemini-1.5-* and gemini-2.0-* are shut down).
# "gemini-flash-latest" tracks Google's newest Flash release automatically.
GEMINI_MODEL=gemini-3.8-flash

# --- WhatsApp creator notifications (Meta WhatsApp Business Cloud API) ----------------
# Optional, set both or neither. Unset = invitation notices are logged, never sent.
# Requires an approved template named "campaign_invitation" (es_MX) with 6 body
# parameters (see src/modules/notifications/whatsapp.service.ts), and only creators
# who opted in (PATCH /v1/creators/me {"phone", "whatsapp_opt_in": true}) are messaged.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Origin serving the creator invitation pages; WhatsApp magic links point to
# <CREATOR_APP_URL>/c/invitations/<id>?token=…  Empty = origin of PUBLIC_LINK_BASE_URL.
CREATOR_APP_URL=

# --- Public API URL -------------------------------------------------------------------
# Public HTTPS base URL of this API (e.g. https://api.referals.mx). When a seller
# connects Shopify, webhooks are auto-registered at <PUBLIC_API_URL>/v1/webhooks/shopify.
# Empty = origin of PUBLIC_LINK_BASE_URL. Shopify rejects http:// and localhost, so in
# local development use a tunnel (e.g. ngrok) or leave it pointing at a real deployment.
PUBLIC_API_URL=

# --- Shopify integration -------------------------------------------------------------
# Admin GraphQL API version used for discount provisioning. Shopify supports each
# quarterly version for ~12 months; bump this before the current one is retired.
SHOPIFY_API_VERSION=2026-10
