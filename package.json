{
  "name": "referals",
  "version": "1.0.0",
  "description": "Referals core API — branded coupon issuance & anti-fraud engine",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "worker:escrow": "tsx src/worker.ts",
    "worker:escrow:once": "tsx src/worker.ts --once",
    "db:encrypt-secrets": "tsx src/db/encrypt-webhook-secrets.ts",
    "start:worker": "node dist/worker.js",
    "db:migrate:prod": "node dist/db/migrate.js"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "ioredis-mock": "^8.13.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
